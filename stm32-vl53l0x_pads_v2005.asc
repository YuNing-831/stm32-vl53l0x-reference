!PADS-Layout-ASCII-V2005
; PADS Layout V2005 ASCII netlist export (best-effort compatibility format)
; Project: stm32-vl53l0x
; Generated: 2026-08-31
;
; NOTE: This is a strict-format attempt for PADS Layout V2005 import. If Altium still rejects it,
; please paste the exact Altium error message and I will iterate the syntax to match that importer.

;--------------------------------------------------
; Part list (COMPONENT records)
; Format (conservative): COMP,<RefDes>,<Value>,<Package>,<Library>
;--------------------------------------------------
COMP,U1,STM32F103VCT6,LQFP-100,STM32
COMP,U2,TPS62172,SOT-23-6,TI
COMP,J1,DC_JACK_2.1mm,DC_POWER_JACK,MECH
COMP,J2,VL53_J2_1x6,HDR-1X6_2.54,MECH
COMP,SWD1,SWD_HDR,HDR-2X5_2.54,MECH
COMP,R1,4.7k,RES-0603,RES
COMP,R2,4.7k,RES-0603,RES
COMP,R3,10k,RES-0603,RES
COMP,R4,10k,RES-0603,RES
COMP,C1,0.1uF,CAP-0603,CAP
COMP,C2,22uF,CAP-0805,CAP
COMP,L1,1uH,L-0805,IND
COMP,D1,SS14,DIODE-SMA,DIODE
COMP,F1,PTC,PTC-0402,FUSE
COMP,LED1,LED,LED-0805,LED
COMP,TP1,TP,TP_PAD_1MM,TP

;--------------------------------------------------
; Pin definitions (PIN records)
; Format: PIN,<RefDes>,<PinName>,<PinNumber if present>
; Some importers expect explicit pin names; include critical pins used in netlist.
;--------------------------------------------------
PIN,U1,VDD,VDD
PIN,U1,VSS,VSS
PIN,U1,VDDA,VDDA
PIN,U1,VSSA,VSSA
PIN,U1,PB6,PB6
PIN,U1,PB7,PB7
PIN,U1,PA0,PA0
PIN,U1,PA1,PA1
PIN,U1,PA9,PA9
PIN,U1,PA10,PA10
PIN,U1,NRST,NRST
PIN,U1,BOOT0,BOOT0

PIN,U2,1,IN
PIN,U2,2,SW
PIN,U2,3,LX
PIN,U2,4,GND
PIN,U2,5,FB
PIN,U2,6,EN

PIN,J1,1,VIN_9V
PIN,J1,2,GND

PIN,J2,1,VL53_VCC
PIN,J2,2,VL53_GND
PIN,J2,3,VL53_SDA
PIN,J2,4,VL53_SCL
PIN,J2,5,VL53_XSHUT
PIN,J2,6,VL53_INT

PIN,SWD1,1,SWDIO
PIN,SWD1,2,SWCLK
PIN,SWD1,3,GND
PIN,SWD1,4,VCC
PIN,SWD1,5,NRST

;--------------------------------------------------
; Nets
; Format: NET,<NetName>,<Ref1:Pin>,<Ref2:Pin>,...
;--------------------------------------------------
NET,VIN_9V,J1:1,F1:1,D1:1,U2:1
NET,GND,J1:2,U1:VSS,U1:VSSA,U2:4,J2:2,C1:-,C2:-,LED1:-,TP1
NET,3V3_NET,U2:5,U1:VDD,U1:VDDA,J2:1,C2:+,C1:+,LED1:+,TP1
NET,SDA,U1:PB7,J2:3,R1:1
NET,SCL,U1:PB6,J2:4,R2:1
NET,XSHUT,U1:PA0,J2:5,R3:1
NET,INT,U1:PA1,J2:6
NET,BOOT0,U1:BOOT0,R4:1
NET,NRST,U1:NRST,SWD1:5
NET,USART1_TX,U1:PA9
NET,USART1_RX,U1:PA10

;--------------------------------------------------
; Footprint hints (simple mapping to help importer)
; Format: FOOTPRINT,<RefDes>,<FootprintName>
;--------------------------------------------------
FOOTPRINT,U1,LQFP-100
FOOTPRINT,U2,SOT-23-6
FOOTPRINT,J2,HDR-1X6_2.54
FOOTPRINT,SWD1,HDR-2X5_2.54
FOOTPRINT,R1,RES-0603
FOOTPRINT,C1,CAP-0603
FOOTPRINT,C2,CAP-0805
FOOTPRINT,L1,L-0805

; End of PADS V2005-style ASCII
